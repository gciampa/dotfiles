# Theme
theme = Catppuccin Mocha

# Window
window-width = 170
window-height = 50

# Font
font-style = Regular
font-size = 14

# Cursor styling
cursor-style = block
cursor-style-blink = false

# Shell
shell-integration-features = no-cursor,ssh-env

# Notifications
# Only notify when the window is unfocused, and don't ring the bell
# (default is `always`, which notifies on every cd/ls, etc.)
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 0s
